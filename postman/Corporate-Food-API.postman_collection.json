        {
          "name": "Place Food Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    if (json.data && json.data.id) {",
                  "        pm.collectionVariables.set('foodOrderId', json.data.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": 3,\n  \"weekId\": 1,\n  \"weekdayId\": 2,\n  \"foodId\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/food-orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "food-orders"]
            },
            "description": "Seed menu for week 1 / day 2: food 2 (قیمه). Use employee 3 (emp1) — employee 1 already has day 1 order.\n\n`FoodOrderRequest`: employeeId, weekId, weekdayId, foodId (all required)."
          }
        },
        {
          "name": "Cancel Food Order",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/food-orders/{{foodOrderId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "food-orders", "{{foodOrderId}}", "cancel"]
            },
            "description": "Sets orderStatus to CANCELLED."
          }
        },
        {
          "name": "Delete Food Order",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/food-orders/{{foodOrderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "food-orders", "{{foodOrderId}}"]
            }
          }
        }
      ]

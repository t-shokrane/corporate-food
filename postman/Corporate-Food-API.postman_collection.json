    {
      "name": "Workflows",
      "description": "End-to-end request sequences for common scenarios.",
      "item": [
        {
          "name": "Employee — Browse Menu & Place Order",
          "item": [
            {
              "name": "1. Get Active Working Week",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/working-weeks/enabled?page=0&size=1",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "working-weeks", "enabled"],
                  "query": [
                    { "key": "page", "value": "0" },
                    { "key": "size", "value": "1" }
                  ]
                }
              }
            },
            {
              "name": "2. Get Today's Menu (Saturday = day 1)",
              "request": {
                "method": "GET",
